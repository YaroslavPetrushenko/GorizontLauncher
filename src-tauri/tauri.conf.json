{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gorizont Launcher",
  "version": "0.1.0",
  "identifier": "ru.gorizont.launcher",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "Gorizont Launcher", "width": 1000, "height": 600, "resizable": false, "decorations": false, "backgroundColor": "#0a0a0a" }], "security": { "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://github.com https://*.githubusercontent.com https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" } },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
