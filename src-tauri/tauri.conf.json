{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gorizont Launcher",
  "version": "1.3.9",
  "identifier": "ru.gorizont.launcher",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "Gorizont Launcher", "width": 1120, "height": 680, "minWidth": 860, "minHeight": 560, "resizable": true, "maximizable": true, "center": true, "minimizable": true, "decorations": true, "backgroundColor": "#0a0a0a" }], "security": { "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://github.com https://*.githubusercontent.com https:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
