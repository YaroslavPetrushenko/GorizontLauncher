# Keep webhook secrets out of GitHub. Configure them in a private build environment.
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
WEBHOOK_TOKEN=your_bot_token_here

# Shared HMAC key of the launcher and the server auth plugin (port 22754).
# Players never set this: the launcher embeds it at build time from the GitHub Actions
# secret GORIZONT_HMAC_SECRET (Rust option_env!). Put the same value into the plugin's
# auth.hmacSecret. The local value below is for development builds only.
GORIZONT_HMAC_SECRET=change-me-shared-key
